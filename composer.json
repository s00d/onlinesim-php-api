{
    "name": "s00d/onlinesim-api",
    "description": "PHP client for the OnlineSim API: SMS numbers, rent, account and free numbers.",
    "keywords": ["onlinesim", "sms", "api", "client"],
    "type": "library",
    "license": "Apache-2.0",
    "homepage": "https://s00d.github.io/onlinesim-php-api/",
    "authors": [
        {
            "name": "s00d",
            "email": "Virus191288@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/s00d/onlinesim-php-api/issues",
        "source": "https://github.com/s00d/onlinesim-php-api",
        "docs": "https://s00d.github.io/onlinesim-php-api/"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "s00d\\OnlineSimApi\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "s00d\\OnlineSimApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    }
}
